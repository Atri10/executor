"""The Executor launcher — runs the engine that ships inside this skill.

An installed skill is a copied directory, so the engine travels with the
skill instead of being resolved from a clone on `PYTHONPATH`. Resolve it
relative to this file, never from the caller's working directory: the
launcher runs inside the user's project, where `lib/` does not exist.

    python3 <skill-base-dir>/scripts/executor next

`<skill-base-dir>` is the directory containing the router `SKILL.md`. The
exec bit makes the bare form work where the filesystem keeps it; the
`python3 <path>` spelling is the portable one and is what the skills
document.
"""
from __future__ import annotations

import sys
from pathlib import Path

LIB = Path(__file__).resolve().parent / "lib"
if not (LIB / "executor" / "cli.py").is_file():
    print(f"executor: the bundled engine is missing at {LIB / 'executor'}.\n"
          f"Reinstall the skill; do not edit its contents.", file=sys.stderr)
    raise SystemExit(127)
sys.path.insert(0, str(LIB))

from executor.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(["executor", *sys.argv[1:]]))
