#!/usr/bin/env bash
# Own the plan-set regression pipeline's artifacts: where audit reports and
# repair ledgers live, and whether the set is cleared to execute.
#
# The pipeline itself is executor-plan-regression's skill contract — this
# script is the mechanical half: path resolution (nothing hand-builds a
# location) and the check that turns "every plan audited or waived" into
# an exit code the phase gate and store-check can rely on.
#
# Usage:
#   exec-plan-regression PLAN_FILE dir    # initiative's regression dir
#   exec-plan-regression PLAN_FILE audit  # path for THIS plan's audit file
#   exec-plan-regression PLAN_FILE fix    # path for THIS plan's repair log
#   exec-plan-regression PLAN_FILE check  # every plan clean|waived? exit 1 on gap
#   exec-plan-regression PLAN_FILE init   # seed the summary + rulings home
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/_exec-lib.sh"

[ $# -eq 2 ] || exec_die "usage: exec-plan-regression PLAN_FILE dir|audit|fix|check|init"

plan=$1
action=$2
[ -f "$plan" ] || exec_die "no such plan file: $plan"

plan_id=$(exec_frontmatter "$plan" id)
[ -n "$plan_id" ] || exec_die "no id: in plan frontmatter — the pipeline is keyed by plan IDs"
init_id=$(exec_initiative_of "$plan_id") || exec_die "cannot derive initiative from plan id '$plan_id'"

run_dir=$(exec_initiative_run_dir "$plan_id")
reg_dir="$run_dir/plan-regression"
summary="$reg_dir/summary.md"

# Every plan file in the initiative — the set the pipeline audits. Plan
# files on disk are truth (INDEX rows can lag); sorted so the set is stable.
plan_set() {
  local idir
  idir=$(exec_initiative_dir "$init_id")
  find "$idir/plans" -maxdepth 1 -name "${init_id}-P[0-9][0-9]*.md" 2>/dev/null | sort
}

case "$action" in
  dir)
    mkdir -p "$reg_dir"
    echo "$reg_dir"
    ;;
  init)
    mkdir -p "$reg_dir"
    exec_seed_initiative_rulings "$init_id" >/dev/null
    if [ ! -f "$summary" ]; then
      stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      cat > "$summary" <<EOF
---
kind: gate
id: ${init_id}-plan-regression
initiative: ${init_id}
title: Plan-set regression summary
status: draft
created_at: $stamp
updated_at: $stamp
---

# Plan-set regression — $init_id

*One row per plan. A plan is 'clean' when its audit found nothing or its repair pass closed every finding; 'waived' only when the human explicitly waived a finding — record the waiver in the initiative rulings log too. 'audited' means a report exists but findings remain open.*

| Plan | Status | Audit | Repairs | Notes |
|---|---|---|---|---|
EOF
    fi
    echo "$summary"
    ;;
  audit)
    mkdir -p "$reg_dir"
    seg=$(exec_plan_segment_of "$plan_id") || exec_die "no Pnn segment in plan id '$plan_id'"
    echo "$reg_dir/regression-${seg}.md"
    ;;
  fix)
    mkdir -p "$reg_dir"
    seg=$(exec_plan_segment_of "$plan_id") || exec_die "no Pnn segment in plan id '$plan_id'"
    echo "$reg_dir/fix-${seg}.md"
    ;;
  check)
    # The gate: every plan on disk must have a summary row whose Status is
    # clean or waived, and a regression audit file on disk. A plan with no
    # row or a non-terminal status blocks execution.
    [ -f "$summary" ] || exec_die "no plan-regression summary at $summary — run exec-plan-regression PLAN init and audit the plan set"
    # An empty set is not a clean set: with no plans there is nothing the
    # gate could have audited, and a silent pass would clear execution on
    # an initiative that never drafted anything.
    if [ -z "$(plan_set)" ]; then
      exec_die "no plan files under $(exec_initiative_dir "$init_id")/plans — nothing to clear; draft plans before running the regression gate"
    fi
    problems=0
    while IFS= read -r pfile; do
      [ -n "$pfile" ] || continue
      pid=$(exec_frontmatter "$pfile" id)
      [ -n "$pid" ] || continue
      seg=$(exec_plan_segment_of "$pid" 2>/dev/null || true)
      [ -n "$seg" ] || continue
      row=$(awk -F'|' -v p="$pid" '$2 ~ p { print; exit }' "$summary" 2>/dev/null || true)
      status=$(printf '%s' "$row" | awk -F'|' '{ gsub(/ /,"",$3); print $3 }')
      notes=$(printf '%s' "$row" | awk -F'|' '{ gsub(/^[ \t]+|[ \t]+$/,"",$6); print $6 }')
      if [ -z "$row" ]; then
        echo "AUDIT: $pid has no row in $summary — the plan set is unaudited" >&2
        problems=$((problems + 1))
      elif [ "$status" != "clean" ] && [ "$status" != "waived" ]; then
        echo "AUDIT: $pid summary status is '${status:-empty}' — must be clean or waived (repair the plan or record a human waiver)" >&2
        problems=$((problems + 1))
      elif [ "$status" = "waived" ]; then
        # A waiver is a human decision; a bare 'waived' cell with no note
        # is indistinguishable from a controller self-granting one.
        case "$notes" in
          ""|"—"|"-") echo "AUDIT: $pid is waived with no note — record what was waived and why (and the initiative ruling)" >&2
                      problems=$((problems + 1)) ;;
        esac
      fi
      afile="$reg_dir/regression-${seg}.md"
      if [ ! -f "$afile" ]; then
        echo "AUDIT: $pid has no audit file ($afile) — a row without its report is an unverified claim" >&2
        problems=$((problems + 1))
      elif [ "$(exec_frontmatter "$afile" kind)" != "regression" ]; then
        echo "AUDIT: $afile kind is '$(exec_frontmatter "$afile" kind)' — plan audits carry kind: regression" >&2
        problems=$((problems + 1))
      fi
    done < <(plan_set)
    # Stale rows: a summary row whose plan file no longer exists is an
    # audit of a plan that was renamed or deleted — the clearance record
    # no longer describes the set on disk.
    while IFS= read -r srow; do
      [ -n "$srow" ] || continue
      spid=$(printf '%s' "$srow" | awk -F'|' '{ gsub(/ /,"",$2); print $2 }')
      case "$spid" in INIT-[0-9][0-9][0-9][0-9]-P[0-9][0-9]) ;; *) continue ;; esac
      sseg=$(exec_plan_segment_of "$spid" 2>/dev/null || true)
      [ -n "$sseg" ] || continue
      idir=$(exec_initiative_dir "$init_id")
      if ! find "$idir/plans" -maxdepth 1 -name "${spid}*.md" -print -quit 2>/dev/null | grep -q .; then
        echo "AUDIT: $summary has a row for $spid but no such plan file exists — stale clearance row" >&2
        problems=$((problems + 1))
      fi
    done < <(grep -E '^\| *INIT-[0-9]{4}-P[0-9]{2} *\|' "$summary" || true)
    if [ "$problems" -gt 0 ]; then
      echo "$init_id: $problems plan-regression problem(s) — the set is not cleared to execute" >&2
      exit 1
    fi
    echo "$init_id: plan-regression clean — every plan audited or waived"
    ;;
  *)
    exec_die "unknown action: $action"
    ;;
esac
