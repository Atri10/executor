#!/usr/bin/env bash
# Resolve and ensure a plan's execution workspace, printing its absolute path.
#
# Keyed by the plan's `id:` frontmatter, not its filename, so renaming a plan
# never orphans its artifacts. A plan predating the Executor has no id: and
# falls back to .executor/legacy/<basename>/, preserving old behaviour.
#
# Also seeds the ledger, rulings, preflight, and dispatch files so every run
# has the same shape and no skill has to invent one.
#
# Usage: exec-workspace PLAN_FILE
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/_exec-lib.sh"

[ $# -eq 1 ] || exec_die "usage: exec-workspace PLAN_FILE"

plan=$1
dir=$(exec_workspace_dir "$plan")

plan_id=$(exec_frontmatter "$plan" id)
spec_id=$(exec_frontmatter "$plan" spec)
[ -n "$plan_id" ] || plan_id="(no id: — legacy plan)"
[ -n "$spec_id" ] || spec_id="(none)"

if [ ! -f "$dir/progress.md" ]; then
  cat > "$dir/progress.md" <<EOF
---
kind: ledger
plan: $plan_id
plan_file: $plan
spec: $spec_id
created_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
updated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
---

# Executor ledger

<!-- A ledger whose plan: line names a different plan is not yours — leave
     it and start your own. One line per state change goes under
     "## State changes" at the bottom; the table below is the scan index. -->

## Task status

<!-- State: pending | dispatched | in-fix | complete | parked. One row per
     task, filled as it moves. The resume scan reads this table first: a
     task with no row has never been dispatched. -->

| Task | State | Commits | Review | Notes |
|---|---|---|---|---|

## State changes

<!-- Append-only, one line per state change, newest last. Example:
     INIT-0004-P01-T03: dispatched (model cheap, agent impl-t03-a, base a1b2c3d) -->
EOF
fi

[ -f "$dir/rulings.md" ] || cat > "$dir/rulings.md" <<EOF
---
kind: rulings
plan: $plan_id
plan_file: $plan
created_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
updated_at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
---

# Rulings — $plan_id

<!-- Append-only. Every decision taken on the human's behalf, written the
     moment it is made and mirrored into .local/decisions/. Entries are
     appended at the end of this file by exec-ruling. -->
EOF

[ -f "$dir/preflight-scan.md" ] || cat > "$dir/preflight-scan.md" <<EOF
# Preflight conflict scan — $plan_id

<!-- One row per task pair sharing a file or interface, one row per task for
     self-consistency, and a ruling beside every finding. Written before
     Task 1 dispatches; read whenever a task surprises you. -->

## Scan

<!-- Severity: conflict | self-inconsistent | clean. Every pair sharing a
     file or symbol gets a row; every task gets a self-check row. A finding
     with no ruling is unresolved — do not dispatch until every finding is
     ruled. -->

| Tasks | Shared surface | Produced vs consumed | Finding | Severity | Ruling |
|---|---|---|---|---|---|

## Method

<!-- What was checked: the dependency map rows, the file map, the interface
     signatures, the test expectations. State the inputs you walked so a
     reader can see the scan's scope. -->
EOF

[ -f "$dir/dispatches.md" ] || cat > "$dir/dispatches.md" <<EOF
# Dispatch log — $plan_id

<!-- Context: the brief and context file paths each agent received, so
     'bad context or bad model?' has a one-line answer. Rows append BELOW
     the header, never above it. -->

| Task | Role | Model | Agent | Started | Outcome | Context |
|---|---|---|---|---|---|---|
EOF

# Run registry row, created on first resolution of this plan.
store=$(exec_run_store)
reg="$store/INDEX.md"
if [ ! -f "$reg" ]; then
  {
    echo "# Executor Runs"
    echo
    echo "| Plan ID | Initiative | Status | Tasks | Started | Finished | Workspace |"
    echo "|---|---|---|---|---|---|---|"
  } > "$reg"
fi
if ! grep -q "^| $plan_id |" "$reg" 2>/dev/null; then
  init=$(exec_initiative_of "$plan_id" 2>/dev/null || echo "—")
  rel=${dir#"$store/"}
  awk -v row="| $plan_id | $init | running | 0/? | $(date -u +%Y-%m-%d) | — | \`$rel/\` |" '
    { print }
    /^\|---/ && !done { print row; done = 1 }
  ' "$reg" > "$reg.tmp" && mv "$reg.tmp" "$reg"
fi

echo "$dir"
