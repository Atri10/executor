#!/usr/bin/env bash
# Plan-branch lifecycle: fork from the initiative branch, merge back.
#
# Branch model (issue #6): every plan executes on its own branch, forked
# from the initiative branch. Task commits land there with detailed
# messages; the plan branch merges back to the initiative branch only
# after its final review verdict exists and passes the exec-run audit.
# Initiative completion is the human's decision (executor-handoff).
#
# Usage:
#   exec-branch PLAN_FILE start       fork plan/INIT-NNNN-Pnn from the
#                                     initiative branch (or its recorded
#                                     base), switch to it; prints name
#   exec-branch PLAN_FILE status      print current branch + expectations
#   exec-branch PLAN_FILE merge       merge plan branch into the initiative
#                                     branch (--no-ff); refuses unless the
#                                     exec-run audit passes (final verdict
#                                     exists, every completed task judged)
#   exec-branch PLAN_FILE audit       run that same audit without merging;
#                                     prints the failing AUDIT lines
#   exec-branch PLAN_FILE abandon     delete the plan branch (unmerged work
#                                     is the human's call; refuses if the
#                                     branch has commits not on the base
#                                     unless --force-ish -f is passed)
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/_exec-lib.sh"

[ $# -ge 2 ] || exec_die "usage: exec-branch PLAN_FILE start|status|merge|audit|abandon [-f]"
plan=$1
action=$2
flag=${3:-}
[ -f "$plan" ] || exec_die "no such plan file: $plan"

plan_id=$(exec_frontmatter "$plan" id)
[ -n "$plan_id" ] || exec_die "no id: in plan frontmatter — branch tracking needs an ID"
init=$(exec_initiative_of "$plan_id") || exec_die "cannot derive initiative from $plan_id"

plan_branch="plan/$plan_id"
init_branch="initiative/$init"

current=$(git branch --show-current)

case "$action" in
  start)
    #never switch branches with uncommitted work in play — the
    # edits ride the checkout into the new branch and get committed to
    # the wrong history. The merge path already guards; start guards
    # too, before any checkout.
    if [ -n "$(git status --porcelain)" ]; then
      exec_die "working tree has uncommitted changes — commit, stash, or clean them before starting a plan branch (unrelated work must not ride the checkout)"
    fi
    # The initiative branch must exist first: exec-initiative branch INIT-NNNN.
    if ! git show-ref --verify --quiet "refs/heads/$init_branch"; then
      exec_die "no initiative branch $init_branch — run: exec-initiative branch $init"
    fi
    if git show-ref --verify --quiet "refs/heads/$plan_branch"; then
      # Idempotent resume: same plan, same branch.
      git checkout "$plan_branch" >/dev/null
      echo "$plan_branch"
      exit 0
    fi
    git checkout -b "$plan_branch" "$init_branch" >/dev/null
    echo "$plan_branch"
    ;;
  status)
    echo "current branch: ${current:-(detached HEAD)}"
    echo "plan branch:     $plan_branch"
    echo "initiative:      $init_branch"
    if [ "$current" = "$plan_branch" ]; then
      echo "state:           on the plan branch"
    elif git show-ref --verify --quiet "refs/heads/$plan_branch"; then
      echo "state:           plan branch exists, you are NOT on it"
    else
      echo "state:           plan branch not created yet"
    fi
    ;;
  merge)
    [ "$current" = "$plan_branch" ] || exec_die "you are on '$current', not '$plan_branch' — the audit runs against the plan branch's workspace"
    # A dirty tree must not ride the checkout: git would carry uncommitted
    # changes across to the initiative branch (silent contamination) or die
    # mid-checkout with an error far from its cause.
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      exec_die "working tree has uncommitted changes — commit or stash them before merging"
    fi
    # The merge target must exist before anything else moves.
    git show-ref --verify --quiet "refs/heads/$init_branch" \
      || exec_die "no initiative branch $init_branch — nothing to merge into"
    # Gate: the plan's run must pass the full audit — registry consistent,
    # a verdict for every completed task, and the final verdict present.
    # This is the merge gate; review-before-merge is the whole point of the
    # branch model. The audit's own diagnostics reach the user — a generic
    # refusal without them sent people hunting for the real cause.
    if ! "$0" "$plan" audit; then
      exec_die "merge refused: exec-run audit fails (missing verdict or final review). Run: exec-run PLAN check"
    fi
    git checkout "$init_branch" >/dev/null
    if git merge --no-ff --no-edit "$plan_branch" >/dev/null 2>&1; then
      echo "merged $plan_branch -> $init_branch (no-ff, history preserved)"
      git branch -d "$plan_branch" >/dev/null
    else
      # Conflict: back out the checkout, report. Resolution is a human decision.
      git merge --abort 2>/dev/null || true
      git checkout "$plan_branch" >/dev/null
      exec_die "merge conflict — resolve on the plan branch first (merge $init_branch into $plan_branch, fix, then retry)"
    fi
    ;;
  audit)
    #one canonical semantic audit shared with exec-run. The
    # previous existence-only copy accepted FAIL verdicts and stale
    # content; the shared gate parses verdict content and the exact
    # task set.
    ws=$(exec_workspace_dir "$plan")
    reg="$(exec_run_store)/INDEX.md"
    [ -f "$reg" ] || exec_die "no run registry — run exec-workspace first"
    total=$(grep -c '^### Task ' "$plan" 2>/dev/null || true)
    total=${total:-0}
    if exec_run_audit "$plan" "$ws" "$total" "$reg"; then
      echo "$plan_id: audit passed"
    else
      exec_die "audit failed — see AUDIT lines above"
    fi
    ;;
  abandon)
    case "$flag" in
      ""|-f) ;;
      *) exec_die "usage: exec-branch PLAN_FILE abandon [-f] — unknown flag '$flag'" ;;
    esac
    git show-ref --verify --quiet "refs/heads/$plan_branch" || exec_die "no plan branch to abandon: $plan_branch"
    if [ "$flag" != "-f" ]; then
      # Refuse when the branch carries commits not on the initiative
      # branch — a comparison that needs the base to exist.
      git show-ref --verify --quiet "refs/heads/$init_branch" \
        || exec_die "no initiative branch $init_branch — cannot tell whether $plan_branch carries unique commits; pass -f only if you mean to delete them blind"
      if [ -n "$(git log --oneline "$init_branch".."$plan_branch" 2>/dev/null)" ]; then
        exec_die "$plan_branch has commits not on $init_branch — pass -f to delete them deliberately"
      fi
    fi
    if [ "$current" = "$plan_branch" ]; then
      git show-ref --verify --quiet "refs/heads/$init_branch" \
        || exec_die "on $plan_branch but no initiative branch $init_branch to return to — check out a base branch first"
      git checkout "$init_branch" >/dev/null
    fi
    if [ "$flag" = "-f" ]; then
      # -f is the user's informed choice: force-delete unconditionally.
      git branch -D "$plan_branch" >/dev/null || exec_die "git could not force-delete $plan_branch"
    else
      # -d is the safe delete; if it fails despite a clean unique-commit
      # scan (a race, or an unmerged-but-listed edge), surface git's
      # reason — never silently escalate to a force-delete.
      git branch -d "$plan_branch" >/dev/null \
        || exec_die "could not safely delete $plan_branch — pass -f to force it"
    fi
    echo "abandoned $plan_branch"
    ;;
  *)
    exec_die "unknown action: $action (want start|status|merge|audit|abandon)"
    ;;
esac
