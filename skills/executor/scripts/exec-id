#!/usr/bin/env bash
# Allocate the next free document ID of a kind within one initiative.
#
# Lists the initiative immediately before allocating, so two agents racing
# cannot silently reuse a number: the loser sees the winner's file and takes
# the next one.
#
# Usage: exec-id INIT-0004 ADR
#        exec-id INIT-0004 P        (plans use the P<nn> segment)
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/_exec-lib.sh"

[ $# -eq 2 ] || exec_die "usage: exec-id INIT-NNNN KIND   (KIND: CHTR RSCH OPTS ARCH ADR IFCE DSGN SPEC RISK VRFY P)"

id=$1
kind=$(echo "$2" | tr '[:lower:]' '[:upper:]')

case "$kind" in
  CHTR|RSCH|OPTS|ARCH|ADR|IFCE|DSGN|SPEC|RISK|VRFY|P) ;;
  *) exec_die "unknown kind: $kind" ;;
esac

dir=$(exec_initiative_dir "$id")

# Plans are the one kind whose grammar has no separator: INIT-0004-P01, not
# INIT-0004-P-01. Everything else is -<KIND>-<nn>.
if [ "$kind" = "P" ]; then
  pattern="${id}-P[0-9]{2}"
  fmt='%s-P%02d\n'
else
  pattern="${id}-${kind}-[0-9]{2}"
  fmt="%s-${kind}-%02d\n"
fi

# Scan every file in the initiative for existing IDs of this kind. Scanning
# content as well as filenames means a document filed in the wrong directory
# still reserves its number.
max=0
while IFS= read -r found; do
  n=$((10#${found##*[!0-9]}))
  [ "$n" -gt "$max" ] && max=$n
done < <(
  {
    find "$dir" -type f -name "*.md" -exec basename {} \;
    grep -rhoE "$pattern" "$dir" 2>/dev/null || true
  } | grep -oE "$pattern" || true
)

# shellcheck disable=SC2059  # fmt is built above, not user input
printf "$fmt" "$id" "$((max + 1))"
